+class TestTimedSerializerTimestampValidation(FreezeMixin):
+    @pytest.fixture(params=[TimedSerializer, URLSafeTimedSerializer])
+    def serializer(self, request):
+        return request.param("secret-key")
+
+    @pytest.mark.parametrize("kwargs", [{}, {"max_age": 3600}])
+    @pytest.mark.parametrize("return_timestamp", [False, True])
+    def test_unrepresentable_timestamp(self, serializer, kwargs, return_timestamp):
+        value = {"example": "value"}
+        with patch.object(TimestampSigner, "get_timestamp", return_value=10**12):
+            signed = serializer.dumps(value)
+
+        with pytest.raises(BadTimeSignature) as exc_info:
+            serializer.loads(signed, return_timestamp=return_timestamp, **kwargs)
+
+        assert type(exc_info.value) is BadTimeSignature
+        assert str(exc_info.value) == "Malformed timestamp"
+        assert exc_info.value.payload == serializer.dump_payload(value)
+        assert exc_info.value.date_signed is None
+        assert isinstance(exc_info.value.__cause__, (ValueError, OSError, OverflowError))
+
+    @pytest.mark.parametrize("kwargs", [{}, {"max_age": 3600}])
+    @pytest.mark.parametrize("return_timestamp", [False, True])
+    def test_normal_timestamp(self, serializer, ts, kwargs, return_timestamp):
+        value = {"example": "value"}
+        signed = serializer.dumps(value)
+        expected = (value, ts) if return_timestamp else value
+
+        assert serializer.loads(
+            signed, return_timestamp=return_timestamp, **kwargs
+        ) == expected
+
+    def test_tampered_token(self, serializer, ts):
+        signed = serializer.dumps({"example": "value"})
+        if isinstance(signed, str):
+            signed = signed.encode("utf-8")
+        tampered = b"!" + signed
+
+        with pytest.raises(BadTimeSignature) as exc_info:
+            serializer.loads(tampered)
+
+        assert type(exc_info.value) is BadTimeSignature
+        assert exc_info.value.payload == tampered.rsplit(b".", 2)[0]
+        assert exc_info.value.date_signed == ts
+        assert exc_info.value.date_signed.tzinfo is timezone.utc
