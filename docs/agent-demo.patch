+class TestPoolManagerFileBodies:
+    @pytest.mark.parametrize("use_proxy", [False, True])
+    @pytest.mark.parametrize("status", [200, 301, 302, 303, 307, 308])
+    @pytest.mark.parametrize("body_pos", [None, 0, 7])
+    def test_replay_unread_body(
+        self, use_proxy: bool, status: int, body_pos: int | None
+    ) -> None:
+        data = b"prefix:the upload payload"
+        body = io.BytesIO(data)
+        body.read(7)
+        uploads: list[bytes] = []
+        methods: list[str] = []
+
+        def send_request(
+            _conn: object,
+            method: str,
+            _url: str,
+            body: io.BytesIO | None,
+            **_kwargs: typing.Any,
+        ) -> HTTPResponse:
+            uploads.append(body.read() if body is not None else b"")
+            methods.append(method)
+            # Follow two redirects to check that the original position survives.
+            response_status = status if len(uploads) < 3 else 200
+            return HTTPResponse(
+                status=response_status,
+                headers={"Location": "http://example.com/upload"},
+            )
+
+        manager = ProxyManager("http://proxy.invalid:8080") if use_proxy else PoolManager()
+        with manager, patch.object(
+            HTTPConnectionPool, "_make_request", side_effect=send_request
+        ):
+            response = manager.urlopen(
+                "PUT", "http://example.com/upload", body=body, body_pos=body_pos
+            )
+
+        payload = data[7 if body_pos is None else body_pos :]
+        assert response.status == 200
+        if status == 200:
+            assert uploads == [payload]
+            assert methods == ["PUT"]
+        elif status == 303:
+            assert uploads == [payload, b"", b""]
+            assert methods == ["PUT", "GET", "GET"]
+        else:
+            assert uploads == [payload] * 3
+            assert methods == ["PUT"] * 3
+
+    @pytest.mark.parametrize("operation", ["tell", "seek", "missing_seek"])
+    @pytest.mark.parametrize("status", [200, 303, 307])
+    @pytest.mark.parametrize("redirect", [False, True])
+    def test_unrewindable_body(
+        self, operation: str, status: int, redirect: bool
+    ) -> None:
+        body = io.BytesIO(b"prefix:the upload payload")
+        body.read(7)
+        uploads: list[bytes] = []
+
+        def send_request(
+            *_args: object, body: io.BytesIO | None, **_kwargs: typing.Any
+        ) -> HTTPResponse:
+            uploads.append(body.read() if body is not None else b"")
+            return HTTPResponse(
+                status=status if len(uploads) == 1 else 200,
+                headers={"Location": "/upload"},
+            )
+
+        broken_method = (
+            patch.object(body, "seek", None)
+            if operation == "missing_seek"
+            else patch.object(body, operation, side_effect=OSError)
+        )
+        with PoolManager() as manager, broken_method, patch.object(
+            HTTPConnectionPool, "_make_request", side_effect=send_request
+        ):
+            if redirect and status == 307:
+                with pytest.raises(UnrewindableBodyError):
+                    manager.urlopen(
+                        "PUT", "http://example.com/upload", body=body, redirect=redirect
+                    )
+                assert uploads == [b"the upload payload"]
+            else:
+                response = manager.urlopen(
+                    "PUT", "http://example.com/upload", body=body, redirect=redirect
+                )
+                assert response.status == (200 if redirect else status)
+                assert uploads == (
+                    [b"the upload payload", b""]
+                    if redirect and status == 303
+                    else [b"the upload payload"]
+                )
+
