MATCH (a:Symbol {repo_id:'demo:urllib3:browser:eligible'})-[r:CALLS]->(b:Symbol) WHERE (a.qualname='HTTPConnectionPool.urlopen' AND b.qualname='set_file_position') OR (a.qualname='WrappedSocket.recv' AND b.qualname='wait_for_read') RETURN a.qualname+' → '+b.qualname AS caller_path,r.line AS call_line,b.lineno AS definition_line,r.confidence AS confidence,r.resolution AS resolution ORDER BY caller_path
