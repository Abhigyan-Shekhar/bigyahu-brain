MATCH (pr:PR {repo_id:'demo:urllib3:browser:eligible',number:5161})-[h:CHANGES]->(f:File {path:'src/urllib3/connectionpool.py'})-[:DECLARES]->(s:Symbol {qualname:'HTTPConnectionPool.urlopen'}) MATCH (pr)-[:SUPPORTS]->(src:Source) RETURN pr.url AS pr_url,pr.work_status AS work_status,src.snapshot_at AS snapshot_at,h.confidence AS association_confidence,h.basis AS association_basis,f.revision AS revision,s.path AS symbol_path,s.lineno AS start_line,s.end_lineno AS end_line
