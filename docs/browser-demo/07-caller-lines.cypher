MATCH (a:Symbol {repo_id:'demo:urllib3:browser:eligible'})-[r:CALLS]->(b:Symbol) WHERE (a.qualname='HTTPConnectionPool.urlopen' AND b.qualname='set_file_position') OR (a.qualname='WrappedSocket.recv' AND b.qualname='wait_for_read') RETURN a.qualname AS caller,a.path AS caller_path,r.line AS call_line,b.qualname AS callee,b.path AS definition_path,b.lineno AS definition_line,r.confidence AS confidence,r.resolution AS resolution,b.revision AS revision ORDER BY caller
