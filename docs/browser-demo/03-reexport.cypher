MATCH imports=(f:File {repo_id:'demo:urllib3:browser:eligible',path:'src/urllib3/contrib/pyopenssl.py'})-[:IMPORTS]->(i:File {path:'src/urllib3/util/__init__.py'})-[:IMPORTS]->(w:File {path:'src/urllib3/util/wait.py'}) MATCH caller=(f)-[:DECLARES]->(a:Symbol {qualname:'WrappedSocket.recv'})-[:CALLS]->(b:Symbol {qualname:'wait_for_read'}) MATCH declaration=(w)-[:DECLARES]->(b) RETURN imports,caller,declaration
