+    @pytest.mark.parametrize("failed_method", ["tell", "seek"])
+    @pytest.mark.parametrize("status,redirect", [(200, True), (307, False), (303, True)])
+    def test_file_body_without_replay(
+        self, failed_method: str, status: int, redirect: bool
+    ) -> None:
+        body = io.BytesIO(b"the payload")
+        uploads = []
+
+        def upload(*args: typing.Any, **kwargs: typing.Any) -> HTTPResponse:
+            request_body = kwargs["body"]
+            uploads.append(request_body.read() if request_body is not None else None)
+            return HTTPResponse(
+                status=status if len(uploads) == 1 else 200,
+                headers={"Location": "/echo"},
+                retries=kwargs["retries"],
+            )
+
+        with PoolManager() as manager:
+            with (
+                patch.object(body, failed_method, side_effect=OSError),
+                patch.object(HTTPConnectionPool, "_make_request", side_effect=upload),
+            ):
+                response = manager.urlopen(
+                    "PUT", "http://host/upload", body=body, redirect=redirect
+                )
+
+        if status == 303:
+            assert response.status == 200
+            assert uploads == [b"the payload", None]
+        else:
+            assert response.status == status
+            assert uploads == [b"the payload"]
+
