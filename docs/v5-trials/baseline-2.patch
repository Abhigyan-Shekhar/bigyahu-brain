+    @pytest.mark.parametrize("status", [301, 302, 307, 308])
+    @pytest.mark.parametrize("body_pos", [None, 0, 7])
+    def test_redirect_replays_file_body(
+        self, status: int, body_pos: int | None
+    ) -> None:
+        body = io.BytesIO(b"prefix:the unread payload")
+        body.seek(7)
+        payload = body.getvalue()[7 if body_pos is None else body_pos :]
+        uploads = []
+
+        def upload(*args: typing.Any, **kwargs: typing.Any) -> HTTPResponse:
+            uploads.append(kwargs["body"].read())
+            return HTTPResponse(
+                status=status if len(uploads) < 3 else 200,
+                headers={"Location": "http://other-host/echo"},
+                retries=kwargs["retries"],
+            )
+
+        with PoolManager() as manager:
+            with patch.object(HTTPConnectionPool, "_make_request", side_effect=upload):
+                response = manager.urlopen(
+                    "PUT", "http://host/upload", body=body, body_pos=body_pos
+                )
+
+        assert response.status == 200
+        assert uploads == [payload, payload, payload]
