 class TestPoolManager:
+    @pytest.mark.parametrize("status", [301, 302, 307, 308])
+    @pytest.mark.parametrize("start, body_pos", [(0, None), (7, None), (0, 7), (7, 0)])
+    @pytest.mark.parametrize("redirect_count", [1, 2])
+    @pytest.mark.parametrize("cross_host", [False, True])
+    def test_redirect_replays_file_body(
+        self,
+        status: int,
+        start: int,
+        body_pos: int | None,
+        redirect_count: int,
+        cross_host: bool,
+    ) -> None:
+        data = b"prefix:" + b"upload data" * 8192
+        body = io.BytesIO(data)
+        body.seek(start)
+        expected = data[start if body_pos is None else body_pos :]
+        uploads: list[bytes] = []
+
+        def make_request(
+            conn: HTTPConnection, method: str, url: str, **kwargs: typing.Any
+        ) -> HTTPResponse:
+            assert method == "PUT"
+            uploads.append(kwargs["body"].read())
+            if len(uploads) <= redirect_count:
+                host = "other.example" if cross_host else "example.com"
+                return HTTPResponse(
+                    status=status,
+                    headers={"Location": f"http://{host}/{len(uploads)}"},
+                    retries=kwargs["retries"],
+                )
+            return HTTPResponse(body=b"ok", status=200, retries=kwargs["retries"])
+
+        with PoolManager() as manager, patch.object(
+            HTTPConnectionPool, "_make_request", side_effect=make_request
+        ):
+            response = manager.urlopen(
+                "PUT",
+                "http://example.com/upload",
+                body=body,
+                body_pos=body_pos,
+                headers={"Content-Length": str(len(expected))},
+            )
+
+        assert response.status == 200
+        assert uploads == [expected] * (redirect_count + 1)
+
+    @pytest.mark.parametrize("failure", ["tell", "seek", "missing_seek"])
+    @pytest.mark.parametrize(
+        "status, redirect",
+        [(200, True), (307, False), (303, True), (307, True), (308, True)],
+    )
+    def test_file_body_rewind_only_when_preserved(
+        self, failure: str, status: int, redirect: bool
+    ) -> None:
+        data = b"upload data"
+        body = mock.Mock(wraps=io.BytesIO(data))
+        if failure == "tell":
+            body.tell.side_effect = OSError("tell failed")
+        elif failure == "seek":
+            body.seek.side_effect = OSError("seek failed")
+        else:
+            body.seek = None
+        uploads: list[bytes | None] = []
+
+        def make_request(
+            conn: HTTPConnection, method: str, url: str, **kwargs: typing.Any
+        ) -> HTTPResponse:
+            request_body = kwargs["body"]
+            uploads.append(request_body.read() if request_body is not None else None)
+            if len(uploads) == 1:
+                return HTTPResponse(
+                    status=status,
+                    headers={"Location": "/done"},
+                    retries=kwargs["retries"],
+                )
+            if status == 303:
+                assert method == "GET"
+                assert kwargs["chunked"] is False
+                assert "Content-Length" not in kwargs["headers"]
+            return HTTPResponse(status=200, retries=kwargs["retries"])
+
+        with PoolManager() as manager, patch.object(
+            HTTPConnectionPool, "_make_request", side_effect=make_request
+        ):
+            if redirect and status in (307, 308):
+                with pytest.raises(UnrewindableBodyError):
+                    manager.urlopen(
+                        "PUT", "http://example.com/upload", body=body, redirect=redirect
+                    )
+                assert uploads == [data]
+            else:
+                response = manager.urlopen(
+                    "PUT",
+                    "http://example.com/upload",
+                    body=body,
+                    redirect=redirect,
+                    chunked=True,
+                    headers={"Content-Length": str(len(data))},
+                )
+                assert response.status == (200 if redirect else status)
+                assert uploads == ([data, None] if status == 303 else [data])
+
