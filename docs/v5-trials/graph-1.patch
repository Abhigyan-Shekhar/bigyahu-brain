 class TestPoolManager:
+    @pytest.mark.parametrize("initial_pos, body_pos", [(0, None), (7, None), (7, 0), (0, 7)])
+    @pytest.mark.parametrize("redirects", [1, 2])
+    @pytest.mark.parametrize("status", [301, 302, 307, 308])
+    def test_redirect_file_body(
+        self, initial_pos: int, body_pos: int | None, redirects: int, status: int
+    ) -> None:
+        data = b"prefix!the data"
+        body = io.BytesIO(data)
+        body.seek(initial_pos)
+        expected = data[initial_pos if body_pos is None else body_pos :]
+        uploads: list[bytes] = []
+
+        def send_request(*args: typing.Any, **kw: typing.Any) -> HTTPResponse:
+            uploads.append(kw["body"].read())
+            if len(uploads) <= redirects:
+                return HTTPResponse(
+                    status=status, headers={"Location": "http://other.example/next"}
+                )
+            return HTTPResponse(status=200, body=io.BytesIO(uploads[-1]))
+
+        # Keep the connection pool's body positioning and retry logic intact;
+        # replace only the send that would need a network connection.
+        with (
+            patch("urllib3.connectionpool.HTTPConnectionPool._make_request", send_request),
+            PoolManager() as manager,
+        ):
+            response = manager.request(
+                "PUT", "http://example.com/", body=body, body_pos=body_pos
+            )
+
+        assert response.status == 200
+        assert response.data == expected
+        assert uploads == [expected] * (redirects + 1)
+
+    @pytest.mark.parametrize("status", [200, 303, 307])
+    @pytest.mark.parametrize("failed_method", ["tell", "seek"])
+    def test_file_body_without_rewind(self, status: int, failed_method: str) -> None:
+        data = b"the data"
+        body = io.BytesIO(data)
+        uploads: list[bytes] = []
+
+        def send_request(*args: typing.Any, **kw: typing.Any) -> HTTPResponse:
+            uploads.append(kw["body"].read() if kw["body"] is not None else b"")
+            if len(uploads) == 1:
+                return HTTPResponse(
+                    status=status, headers={"Location": "/next"}, body=uploads[-1]
+                )
+            return HTTPResponse(status=200, body=io.BytesIO(uploads[-1]))
+
+        with (
+            patch("urllib3.connectionpool.HTTPConnectionPool._make_request", send_request),
+            patch.object(body, failed_method, side_effect=OSError),
+            PoolManager() as manager,
+        ):
+            if status == 307:
+                with pytest.raises(UnrewindableBodyError):
+                    manager.request("PUT", "http://example.com/", body=body)
+                assert uploads == [data]
+            else:
+                response = manager.request("PUT", "http://example.com/", body=body)
+                assert response.status == 200
+                assert response.data == (b"" if status == 303 else data)
+                assert uploads == ([data, b""] if status == 303 else [data])
+
