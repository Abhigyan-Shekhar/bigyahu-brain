 class TestPoolManager:
+    @pytest.mark.parametrize("status", [301, 302, 307, 308])
+    @pytest.mark.parametrize("offset, body_pos", [(0, None), (7, None), (0, 7)])
+    @pytest.mark.parametrize("redirects", [1, 2])
+    def test_redirect_replays_file_body(
+        self, status: int, offset: int, body_pos: int | None, redirects: int
+    ) -> None:
+        data = b"prefix:the upload payload"
+        body = io.BytesIO(data)
+        body.seek(offset)
+        uploads: list[bytes] = []
+
+        def send_request(
+            *args: typing.Any, body: io.BytesIO, retries: retry.Retry, **kw: typing.Any
+        ) -> HTTPResponse:
+            uploads.append(body.read())
+            if len(uploads) <= redirects:
+                return HTTPResponse(
+                    status=status,
+                    headers={"Location": "http://other.example/echo"},
+                    retries=retries,
+                )
+            return HTTPResponse(status=200, body=uploads[-1], retries=retries)
+
+        with patch.object(HTTPConnectionPool, "_make_request", side_effect=send_request):
+            with PoolManager() as manager:
+                response = manager.urlopen(
+                    "PUT", "http://example.com/upload", body=body, body_pos=body_pos
+                )
+        expected = data[offset if body_pos is None else body_pos :]
+        assert response.status == 200
+        assert uploads == [expected] * (redirects + 1)
+        assert response.data == expected
+
+    @pytest.mark.parametrize("failed_method", ["tell", "seek"])
+    @pytest.mark.parametrize(
+        "status, redirect", [(200, True), (303, True), (307, True), (307, False)]
+    )
+    def test_upload_with_unrewindable_file_body(
+        self, failed_method: str, status: int, redirect: bool
+    ) -> None:
+        data = b"the upload payload"
+        body = io.BytesIO(data)
+        uploads: list[tuple[str, bytes]] = []
+
+        def send_request(
+            conn: typing.Any,
+            method: str,
+            url: str,
+            body: io.BytesIO | None,
+            retries: retry.Retry,
+            **kw: typing.Any,
+        ) -> HTTPResponse:
+            payload = body.read() if body is not None else b""
+            uploads.append((method, payload))
+            return HTTPResponse(
+                status=status if len(uploads) == 1 else 200,
+                headers={"Location": "/echo"},
+                body=payload,
+                retries=retries,
+            )
+
+        with patch.object(body, failed_method, side_effect=OSError):
+            with patch.object(HTTPConnectionPool, "_make_request", side_effect=send_request):
+                with PoolManager() as manager:
+                    if status == 307 and redirect:
+                        with pytest.raises(UnrewindableBodyError):
+                            manager.urlopen(
+                                "PUT", "http://example.com/upload", body=body
+                            )
+                        assert uploads == [("PUT", data)]
+                    else:
+                        response = manager.urlopen(
+                            "PUT", "http://example.com/upload", body=body, redirect=redirect
+                        )
+                        assert response.status == (307 if not redirect else 200)
+                        expected = [("PUT", data)]
+                        if status == 303:
+                            expected.append(("GET", b""))
+                        assert uploads == expected
