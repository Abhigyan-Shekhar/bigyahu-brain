+    @pytest.mark.parametrize("status", [301, 302, 307, 308])
+    @pytest.mark.parametrize("offset", [0, 7])
+    @pytest.mark.parametrize("chunked", [False, True])
+    def test_redirect_replays_file_body(
+        self, status: int, offset: int, chunked: bool
+    ) -> None:
+        data = b"prefix:" + b"the upload payload" * 2048
+        body = io.BytesIO(data)
+        body.seek(offset)
+        headers = {} if chunked else {"Content-Length": str(len(data) - offset)}
+        with PoolManager(timeout=LONG_TIMEOUT) as http:
+            response = http.urlopen(
+                "PUT",
+                f"{self.base_url}/redirect?target=/echo&status={status}",
+                body=body,
+                headers=headers,
+                chunked=chunked,
+                retries=Retry(total=2, read=0),
+            )
+        assert response.status == 200
+        assert response.data == data[offset:]
+
+    @pytest.mark.parametrize("body_pos", [None, 7])
+    def test_repeated_cross_host_redirect_replays_file_body(
+        self, body_pos: int | None
+    ) -> None:
+        data = b"prefix:the upload payload"
+        body = io.BytesIO(data)
+        body.seek(7 if body_pos is None else 0)
+        target = f"{self.base_url_alt}/redirect?target=/echo&status=308"
+        query = urlencode({"target": target, "status": 307})
+        with PoolManager(timeout=LONG_TIMEOUT) as http:
+            response = http.urlopen(
+                "PUT",
+                f"{self.base_url}/redirect?{query}",
+                body=body,
+                body_pos=body_pos,
+                chunked=True,
+            )
+        assert response.status == 200
+        assert response.data == data[7:]
+        assert response.retries is not None
+        assert len(response.retries.history) == 2
