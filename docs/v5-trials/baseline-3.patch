 class TestPoolManager:
+    @pytest.mark.parametrize("status", [301, 302, 307, 308])
+    @pytest.mark.parametrize(
+        "initial_pos, body_pos", [(0, None), (7, None), (0, 7), (7, 0)]
+    )
+    def test_redirect_replays_file_body(
+        self, status: int, initial_pos: int, body_pos: int | None
+    ) -> None:
+        data = b"prefix original payload"
+        body = io.BytesIO(data)
+        body.seek(initial_pos)
+        uploads: list[bytes] = []
+
+        def make_request(*args: typing.Any, **kw: typing.Any) -> HTTPResponse:
+            uploads.append(kw["body"].read())
+            # Follow a same-host redirect, then a cross-host redirect.
+            locations = ["/second", "http://other.example/third"]
+            headers = (
+                {"Location": locations[len(uploads) - 1]} if len(uploads) < 3 else {}
+            )
+            return HTTPResponse(
+                status=status if headers else 200,
+                headers=headers,
+                body=b"",
+                retries=kw["retries"],
+            )
+
+        with PoolManager() as manager:
+            with patch.object(
+                HTTPConnectionPool, "_make_request", side_effect=make_request
+            ):
+                response = manager.urlopen(
+                    "PUT", "http://example.com/first", body=body, body_pos=body_pos
+                )
+
+        expected_pos = initial_pos if body_pos is None else body_pos
+        assert response.status == 200
+        assert uploads == [data[expected_pos:]] * 3
+
+    @pytest.mark.parametrize("failure", ["tell", "seek"])
+    @pytest.mark.parametrize(
+        "status, redirect",
+        [(200, True), (303, True), (307, False), (307, True), (308, True)],
+    )
+    def test_file_body_rewind_failure(
+        self, failure: str, status: int, redirect: bool
+    ) -> None:
+        data = b"prefix original payload"
+        body = io.BytesIO(data)
+        body.seek(7)
+        uploads: list[bytes | None] = []
+
+        def make_request(*args: typing.Any, **kw: typing.Any) -> HTTPResponse:
+            uploads.append(kw["body"].read() if kw["body"] is not None else None)
+            return HTTPResponse(
+                status=status if len(uploads) == 1 else 200,
+                headers={"Location": "/echo"},
+                body=b"",
+                retries=kw["retries"],
+            )
+
+        with PoolManager() as manager:
+            with (
+                patch.object(body, failure, side_effect=OSError),
+                patch.object(HTTPConnectionPool, "_make_request", side_effect=make_request),
+            ):
+                if redirect and status in (307, 308):
+                    with pytest.raises(UnrewindableBodyError):
+                        manager.urlopen(
+                            "PUT", "http://example.com/first", body=body, redirect=redirect
+                        )
+                else:
+                    response = manager.urlopen(
+                        "PUT", "http://example.com/first", body=body, redirect=redirect
+                    )
+                    assert response.status == (200 if status == 303 else status)
+
+        assert uploads == ([data[7:], None] if status == 303 else [data[7:]])
+
