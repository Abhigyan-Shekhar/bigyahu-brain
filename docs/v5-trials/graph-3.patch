 class TestPoolManager:
+    @pytest.mark.parametrize("status", [301, 302, 307, 308])
+    @pytest.mark.parametrize(
+        "initial_pos,body_pos", [(0, None), (7, None), (7, 0), (0, 7)]
+    )
+    @pytest.mark.parametrize("cross_host", [False, True])
+    def test_redirect_replays_file_body(
+        self, status: int, initial_pos: int, body_pos: int | None, cross_host: bool
+    ) -> None:
+        data = b"prefix:payload"
+        body = io.BytesIO(data)
+        body.seek(initial_pos)
+        expected = data[initial_pos if body_pos is None else body_pos :]
+        uploads: list[bytes] = []
+        target = "http://other.test/upload" if cross_host else "/upload"
+
+        def send(*args: typing.Any, **kwargs: typing.Any) -> HTTPResponse:
+            uploads.append(kwargs["body"].read())
+            if len(uploads) < 3:
+                return HTTPResponse(status=status, headers={"Location": target})
+            return HTTPResponse(status=200, body=uploads[-1])
+
+        # Keep the real connection-pool rewind and retry logic, replacing only
+        # transport so that every request's uploaded bytes can be checked.
+        with PoolManager() as manager, patch.object(
+            HTTPConnectionPool, "_make_request", side_effect=send
+        ):
+            response = manager.urlopen(
+                "PUT", "http://example.test/upload", body=body, body_pos=body_pos
+            )
+
+        assert response.status == 200
+        assert uploads == [expected] * 3
+        assert response.data == expected
+
+    @pytest.mark.parametrize("failure", ["tell", "seek"])
+    @pytest.mark.parametrize(
+        "status,follow_redirect", [(200, True), (303, True), (307, False), (307, True)]
+    )
+    def test_file_body_rewind_failure(
+        self, failure: str, status: int, follow_redirect: bool
+    ) -> None:
+        class FileBody(io.BytesIO):
+            def tell(self) -> int:
+                if failure == "tell":
+                    raise OSError("tell failed")
+                return super().tell()
+
+            def seek(self, *args: typing.Any) -> int:
+                if failure == "seek":
+                    raise OSError("seek failed")
+                return super().seek(*args)
+
+        uploads: list[bytes] = []
+
+        def send(*args: typing.Any, **kwargs: typing.Any) -> HTTPResponse:
+            body = kwargs["body"]
+            uploads.append(body.read() if body is not None else b"")
+            if len(uploads) == 1:
+                return HTTPResponse(status=status, headers={"Location": "/upload"})
+            return HTTPResponse(status=200)
+
+        with PoolManager() as manager, patch.object(
+            HTTPConnectionPool, "_make_request", side_effect=send
+        ):
+            if status == 307 and follow_redirect:
+                with pytest.raises(UnrewindableBodyError):
+                    manager.urlopen(
+                        "PUT", "http://example.test/upload", body=FileBody(b"payload")
+                    )
+                assert uploads == [b"payload"]
+            else:
+                response = manager.urlopen(
+                    "PUT",
+                    "http://example.test/upload",
+                    body=FileBody(b"payload"),
+                    redirect=follow_redirect,
+                )
+                assert response.status == (200 if follow_redirect else status)
+                assert uploads == ([b"payload", b""] if status == 303 else [b"payload"])
+
